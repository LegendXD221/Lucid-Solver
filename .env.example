# ---------------------------------------------------------------------------
# Lucid Turnstile Solver - environment template
# Copy to ".env" and edit.  Every variable is optional unless marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Bind address for uvicorn.  Use 0.0.0.0 inside Docker, 127.0.0.1 for local.
HOST=0.0.0.0
# Port the HTTP server listens on.
PORT=8000
# Uvicorn worker count.  Each worker owns its own Chromium + stats.
WORKERS=4
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Auth -----------------------------------------------------------------
# Set to a long random string to require X-API-Key on every request.
# Leave blank to run in open mode (no auth).
API_KEY=

# --- Solver ---------------------------------------------------------------
# Run Chromium without a visible window.  Keep true in production.
HEADLESS=true
# Number of attempts before a solve is considered failed.
MAX_RETRIES=3
# Per-attempt timeout in seconds.
SOLVE_TIMEOUT=30
# Override the user-agent sent by Chromium.  Leave blank for the default.
USER_AGENT=
# Path to the Chromium binary.  Auto-detected if unset; the Dockerfile
# sets this to /usr/bin/chromium.
CHROMIUM_PATH=
# Directory for the generated temp HTML files.  Defaults to /tmp.
TMP_DIR=

# --- Proxy pool -----------------------------------------------------------
# Comma-separated list of proxies, e.g.
#   http://user:pass@10.0.0.1:8080,socks5://10.0.0.2:1080,10.0.0.3:9080
# When empty the solver reads proxies.txt next to the project root instead.
PROXY_LIST=
# Path to a newline-separated proxy file (only used when PROXY_LIST is empty).
# Defaults to ./proxies.txt
PROXIES_FILE=proxies.txt
