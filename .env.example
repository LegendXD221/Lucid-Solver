# ---------------------------------------------------------------------------
# Lucid Turnstile Solver - environment template (v2, patchright-based)
# Copy to ".env" and edit.  Every variable is optional unless marked REQUIRED.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=INFO

# --- Auth -----------------------------------------------------------------
# Set to a long random string to require X-API-Key on every request.
# Leave blank to run in open mode (no auth).
API_KEY=

# --- Solver ---------------------------------------------------------------
# Run the browser without a visible window.
HEADLESS=true
# Number of attempts before a solve is considered failed.
MAX_RETRIES=3
# Per-attempt timeout in seconds.
SOLVE_TIMEOUT=30
# Override the user-agent sent by the browser.  Leave blank for a realistic
# default Chrome UA.
USER_AGENT=
# Browser engine: "chrome" (system Google Chrome, best stealth - default),
# "chromium" (patchright's patched build), "msedge" (system Edge).
BROWSER_TYPE=chrome
# Path to a browser binary.  Overrides BROWSER_TYPE.  Auto-detected if unset.
BROWSER_PATH=

# --- Proxy pool -----------------------------------------------------------
# Comma-separated list of proxies, e.g.
#   http://user:pass@10.0.0.1:8080,socks5://10.0.0.2:1080,10.0.0.3:9080
# When empty the solver reads proxies.txt next to the project root instead.
PROXY_LIST=
PROXIES_FILE=proxies.txt
